void setup() {
  Serial.begin(9600);
  pinMode(button1, INPUT_PULLUP);
  pinMode(button2, INPUT_PULLUP);
  pinMode(button3, INPUT_PULLUP);
  pinMode(button4, INPUT_PULLUP);

  for (int i = 0; i < 4; i++) {
    tservo[i].servo.attach(tservo[i].pin);
    tservo[i].servo.write(tservo[i].pos);
    delay(20);
  }
  delay(200);
  restart();
  Serial.println(F("// 按键1: 单击:夹取A/B/C循环  双击:播放录制 //"));
  Serial.println(F("// 按键2: 单击:录制开始/结束  双击:回中 //"));
  Serial.println(F("// 按键3: 单击:画直线  双击:画V //"));
  Serial.println(F("// 按键4: 单击:示教打点/暂停继续  双击:结束示教/取消绘图 //"));
}

void loop() {
  mod_check();
  if(!is_draw_mode){
    if (rec_state) {
      joy_control();
      if (millis() - rec_time >= rec_len * rec_interval && rec_len < rec_max) {
        rec_b[rec_len] = tservo[0].pos;
        rec_r[rec_len] = tservo[1].pos;
        rec_f[rec_len] = tservo[2].pos;
        rec_c[rec_len] = tservo[3].pos;
        rec_len++;
      }
      if (read(button2)) rec_stop();
      return;
    }
    int b1 = read_tap(button1);
    if (b1 == 1) {
      Serial.print(F("//夹取物体"));
      Serial.println((char)('A' + x));
      pick(x);
      x = (x + 1) % 3;
    } 
    else if (b1 == 2) {
      rec_play();
    }

    int b2 = read_tap(button2);
    if (b2 == 1) {
      rec_start();
    } 
    else if (b2 == 2) {
      restart();
      Serial.println(F("// 已回中 //"));
    }
    return;
  }

  if (draw_mode == 1) {
    task_draw_line();
    return;
    }
  if (draw_mode == 2) {
    task_draw_v();
    return;
    }
  if (draw_mode == 3) {
    task_draw_polyline();
    return;
    }
  if (draw_mode == 4) {
    task_draw_curve();
    return;
    }

  // === 五点示教模式 ===
  static bool teach_mode = false;
  if (teach_mode) {
    joy_control();
    // 按键4单击：记录当前点
    if (read(button4)) {
      if (teach_n < 5) {
        float fx, fy;
        fk_current(fx, fy);
        teach_x[teach_n] = (int16_t)fx;
        teach_y[teach_n] = (int16_t)fy;
        teach_n++;
        Serial.print(F("// 示教点 "));
        Serial.print(teach_n);
        Serial.print(F(" 已记录 X="));
        Serial.print((int)fx);
        Serial.print(F(" Y="));
        Serial.println((int)fy);
      }
      if (teach_n >= 5) {
        Serial.println(F("// 5点已齐，按按键4双击选择绘制模式 //"));
      }
    }
    
    // 按键4双击：结束示教，选择绘制类型
    if (read_tap(button4) == 2) {
      teach_mode = false;
      if (teach_n >= 5) {
        Serial.println(F("// 请选择: 按键3单击=折线, 按键3双击=曲线 //"));
        // 等待用户选择
        while (true) {
          int sel = read_tap(button3);
          if (sel == 1) { draw_mode = 3; break; }
          if (sel == 2) { draw_mode = 4; break; }
          // 按键2双击可放弃本次示教
          if (read_tap(button2) == 2) { 
            teach_n = 0; 
            Serial.println(F("// 已放弃示教 //"));
            break; 
          }
          delay(50);
        }
      } else {
        Serial.println(F("// 示教点不足5个，已清除 //"));
        teach_n = 0;
      }
    }
  }
  
  // 按键3处理
  int b3 = read_tap(button3);
  if (b3 == 1) {
    draw_mode = 1; // 画直线
  } else if (b3 == 2) {
    draw_mode = 2; // 画V
  }
  
  // 按键4处理 (非示教模式下)
  int b4 = read_tap(button4);
  if (b4 == 1) {
    // 进入五点示教模式
    teach_mode = true;
    teach_n = 0;
    Serial.println(F("// 进入五点示教模式，请用摇杆移动笔尖到目标点 //"));
    Serial.println(F("// 按按键4单击记录点，双击结束示教 //"));
  }
  // b4双击在非绘图/非示教模式下无操作
}
